name: Public regression
on:
  push:
  pull_request:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  quick-regression:
    runs-on: windows-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
          cache: pip
      - name: Install runtime dependencies
        run: python -m pip install -r requirements.txt -r requirements-walking.txt
      - name: Run public quick regressions
        run: python scripts/run_checks.py
      - name: Preserve regression result
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: public-regression-result
          path: artifacts/public_regression_result.json
